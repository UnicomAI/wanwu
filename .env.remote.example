# Remote-only overrides for WANWU.
# Copy this file to `.env.remote` (which is gitignored) and tweak values per environment.
# Source it after `.env` when running remotely, e.g. `set -a && source .env && source .env.remote && set +a`.

# Public endpoint for the remote host.
WANWU_EXTERNAL_IP=34.238.142.181
WANWU_EXTERNAL_PORT=8081
WANWU_EXTERNAL_SCHEME=http
WANWU_EXTERNAL_ENDPOINT=${WANWU_EXTERNAL_IP}:${WANWU_EXTERNAL_PORT}
WANWU_WEB_BASE_URL=${WANWU_EXTERNAL_SCHEME}://${WANWU_EXTERNAL_ENDPOINT}
WANWU_API_BASE_URL=${WANWU_WEB_BASE_URL}/service/api
WANWU_APP_OPEN_BASE_URL=${WANWU_WEB_BASE_URL}/aibase/webChat

# Remote docker network (set to an existing network if you already created one).
WANWU_DOCKER_NETWORK=wanwu-remote-net

# Remote BFF workflow template behavior.
WANWU_BFF_WORKFLOW_TEMPLATE_SERVER_MODE=remote
WANWU_BFF_WORKFLOW_TEMPLATE_GLOBAL_WEB_LIST_URL=${WANWU_WEB_BASE_URL}/aibase/public/templateSquare

# Example: pin remote services to managed endpoints instead of docker-compose containers.
#WANWU_MYSQL_HOST=10.0.0.10
#WANWU_MYSQL_PORT=3306
#WANWU_REDIS_HOST=10.0.0.11
#WANWU_REDIS_PORT=6379

# Place any remote-only secrets or overrides below this line.
