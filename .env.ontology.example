# db: mysqls
ONTOLOGY_DB_NAME=kweaver

ONTOLOGY_REDIS_USER=default
ONTOLOGY_ELASTIC_PROTOCOL=https

# ============================================
# Authentication Services
# ============================================
ONTOLOGY_AUTH_ENABLED=false

# ============================================
# Java Services JVM Options
# ============================================
ONTOLOGY_DATA_CONNECTION_JAVA_OPTS=-Xms256m -Xmx512m
ONTOLOGY_VEGA_GATEWAY_JAVA_OPTS=-Xms256m -Xmx512m

# ============================================
# Wanwu Services
# ============================================
WANWU_BFF_SERVICE_URL=http://bff-service:6667
WANWU_BFF_CALLBACK_SERVICE_URL=http://bff-service:6668

# ============================================
# ontology Services
# ============================================
ONTOLOGY_BUSINESS_DOMAIN_ENABLED=false
ONTOLOGY_AGENT_GUNICORN_WORKERS=5
ONTOLOGY_AGENT_GUNICORN_TIMEOUT=600
ONTOLOGY_AES_KEY=ontology


BKN_BACKEND_INTERNAL_URL=http://bkn-backend:13014/api/bkn-backend/in/v1

# ============================================
# 定时任务结果邮件通知 SMTP 配置
# 留空则邮件功能不可用（send_result 返回 failed），不影响定时任务主流程。
# SSL 自动判断：port=465→SSL，port=587→STARTTLS，其他按 DH_SMTP_USE_SSL。
# ============================================
DH_SMTP_HOST=
DH_SMTP_PORT=465
DH_SMTP_USER=
DH_SMTP_PASS=
DH_SMTP_FROM_NAME=数字员工
DH_SMTP_USE_SSL=auto
DH_SMTP_TIMEOUT=15

# ============================================
# 定时任务大文件对象存储（MinIO/S3 兼容）
# 工作区文件 ≥ DH_WS_ATTACH_THRESHOLD_MB 时上传到对象存储，邮件正文放 presigned 下载链接。
# 复用 infra 的 WANWU_MINIO_* 凭证；WANWU_MINIO_HOST 留空则禁用对象存储，大文件直接跳过。
# presigned URL 有效期 DH_OSS_LINK_TTL_DAYS 天，minio SDK 硬上限 7 天。
# ============================================
DH_OSS_BUCKET=dh-attachments
DH_OSS_SECURE=false
DH_OSS_LINK_TTL_DAYS=7
DH_WS_ATTACH_THRESHOLD_MB=25
DH_WS_MAX_FILE_SIZE_MB=200
