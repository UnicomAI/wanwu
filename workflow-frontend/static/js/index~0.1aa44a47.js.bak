l_ranking_data_cutoff_date":"Data Cutoff Date","model_ranking_pure_model_battle_explain":"No Agent Participation","model_ranking_pure_model_battle_top_n":"Pure Model Battle Top {n}","model_ranking_ranking":"Ranking","model_ranking_title":"Model Ranking","model_ranking_total_participating_models":"Total Participating Models","model_ranking_total_participating_models_view":"\\n","model_ranking_total_votes":"Total Votes","model_ranking_view_ranking_details":"View Ranking Details","model_selection":"Model selection","model_selection_coze":"Coze Selection","model_setting_alert":"Note: Values less than 0 may cause timeouts when invoking plugin knowledge bases or other functions!","model_setting_alert_2":"Note: Setting the value too small may result in function call request timeouts!","model_settings_title":"Model settings","model_sp_input_cached_support":"Cached system prompt","model_sp_input_cached_unsupport":"Uncached system prompt","model_support_poor":"The following features have poor performance with the current model","model_support_poor_warning":"Please note that {modelName} has poor support for the following features","model_tag":"Model tag","model_tag_audio_available":"Audio understanding","model_tag_free":"Free","model_tag_functioncall_available":"Functioncall","model_tag_img_available":"Image understanding","model_tag_pay":"Premium","model_tag_video_available":"Video understanding","model_tooltips_model_setting":"Model settings","model_tooltips_view_detail":"View details","models_arena_attach_tooltips":"File format: image, PDF, DOCX, Excel, or CSV.","models_arena_bot_category_01":"Information analysis and processing","models_arena_bot_category_02":"Knowledge application","models_arena_bot_category_03":"Reasoning ability","models_arena_bot_category_04":"Coding ability","models_arena_bot_category_05":"Task resolution","models_arena_bot_category_06":"Generative creation","models_arena_bot_category_07":"Role playing","models_arena_collapse_parameters":"Collapse model parameters","models_arena_detail_title":"Anonymous Battle - Model Square - Coze","models_arena_expand_parameters":"Expand model parameters","models_arena_param_class_balance":"Balance","models_arena_param_class_creative":"Creative","models_arena_param_class_custom":"Custom","models_arena_param_class_precise":"Precise","models_arena_pkpage_a_is_better":"A performed better","models_arena_pkpage_b_is_better":"B performed better","models_arena_pkpage_both_are_bad":"Both are bad","models_arena_pkpage_both_are_good":"Both are good","models_arena_pkpage_cancel":"Cancel","models_arena_pkpage_confirm":"Confirm","models_arena_pkpage_exit_confirmation_description":"Exiting will clear the messages generated on this page and you will not be able to continue voting for the models in this battle.","models_arena_pkpage_exit_confirmation_title":"Exit This Battle","models_arena_pkpage_pure_model_competition":"Pure Model Battle","models_arena_pkpage_pure_model_competition_description":"You have selected no agent for this battle, so models will address your questions","models_arena_pkpage_pure_model_description":"In this battle, the models will address your questions. Please enter your question or select a question bank below and get started!","models_arena_pkpage_pure_model_modelA":"Model A","models_arena_pkpage_pure_model_modelB":"Model B","models_arena_pkpage_restart":"Restart","models_arena_pkpage_restart_confirmation_description":"Restarting will clear all messages on the current page and you will not be able to continue voting for the models in this battle.","models_arena_pkpage_restart_confirmation_title":"Restart Battle","models_arena_pkpage_select_bot":"Select Agent","models_arena_pkpage_voting_rules":"Make sure to engage in an effective conversation with the model before voting. Your vote is very important, so please choose carefully.","models_arena_popup_cancel":"Cancel","models_arena_popup_describe":"Are you sure you want to submit it and continue?","models_arena_popup_submit_and_continue":"Submit and Continue","models_arena_popup_title":"Feedback Not Submitted","models_arena_question_bank_all_questions_have_been":"We\'ve run out of questions in this bank. Try switching to a different question bank!","models_arena_question_bank_highlight_click_here_to_ask":"Click here to ask a question","models_arena_question_bank_highlight_got_it":"Got it","models_arena_question_bank_highlight_use_these_questions_as":"Choose topics that interest you to compare model capabilities!","models_arena_question_bank_hover_current_selection_bankname":"Current question bank: {bank_name}","models_arena_question_bank_hover_qbank":"Question Bank","models_arena_question_bank_hover_remove_bankname":"Remove {bank_name}","models_arena_question_bank_question_bank":"Question Bank","models_arena_question_bank_question_bank_successfully_loaded":"Question bank loaded","models_arena_question_bank_reference_answer":"Reference Answer","models_arena_question_bank_select_question_bank":"Select Question Bank","models_arena_question_bank_with_answers":"Reference Answer","models_arena_questionbank_category_01":"Subject knowledge","models_arena_questionbank_category_02":"Fun questions","models_arena_questionbank_category_03":"Basic capabilities","models_arena_questionbank_category_04":"Generative creation","models_arena_response_format_0":"Text","models_arena_response_format_1":"Markdown","models_arena_response_format_2":"JSON","models_arena_resultpage_has_received_n_votes":"{n} vote(s) received","models_arena_resultpage_lose":"Lost","models_arena_resultpage_restart":"Restart","models_arena_resultpage_share":"Share","models_arena_resultpage_vs":"vs.","models_arena_resultpage_win":"Won","models_arena_select_bot_select_bot":"Select Agent","models_arena_select_bot_select_randomly":"Random","models_arena_share_copy":"Copy","models_arena_share_copy_link":"Copy link","models_arena_share_download":"Download","models_arena_share_speech":"Ready to unveil the most powerful AI model? Join us at Coze for an anonymous model showdown and find out immediately!","models_arena_sp_comments_bot_configuration":"View detailed agent configuration","models_arena_sp_comments_persona_prompt":"Persona & Prompt","models_arena_sp_comments_placeholder":"How would you rate these two models? Leave your comments here!","models_arena_sp_comments_submit":"Submit","models_arena_startpage_anon_arena":"Anonymous Battle","models_arena_startpage_detailed_rules":"Detailed Rules","models_arena_startpage_main_start":"Start model battle","models_arena_startpage_model_collaboration":"Model Cooperation","models_arena_startpage_model_leaderboard":"Leaderboard","models_arena_startpage_model_square":"Model Square","models_arena_startpage_pick_a_bot_to":"Select an agent and get started","models_arena_startpage_random_start_tips":"Start random agent model battle","models_arena_startpage_rules":"Rules","models_arena_startpage_rules_description":"The system will randomly select two anonymous models to battle, and they will answer your questions simultaneously. Vote for the one you prefer! Please note that if the model\'s identity is revealed during the chat, the vote will be invalid.","models_arena_startpage_start_botless":"Pure Model Battle","models_arena_startpage_start_randomly":"Random Start","models_arena_startpage_welcome_title":"Pick your most powerful model!","models_arena_title":"Model Square - Coze","models_arena_toast_submission_failed_reason":"Content contains sensitive information. Please revise it and submit again.","models_arena_toast_submission_successful":"Feedback submitted successfully","models_config_frequency_penalty":"Frequency penalty","models_config_max_tokens":"Max. response length","models_config_presence_penalty":"Presence penalty","models_config_top_p":"Top p","models_leaderboard_ci":"95% CI","models_leaderboard_ci_introduction":"The 95% CI means that there is a 95% probability that the true value of the Elo rating falls within the range of Elo rating +N/-N. A smaller interval indicates higher confidence in the rating due to less uncertainty, while a larger interval indicates lower confidence in the rating due to greater uncertainty.","models_leaderboard_days":"Days","models_leaderboard_elo":"Elo","models_leaderboard_elo_score_introduction":"The Elo rating system calculates the relative skill levels of players in two-player competitions. Match outcomes can be predicted based on the difference in ratings between two players. If both players have equal ratings, they are expected to win an equal number of games. Elo ratings change based on match results, with the winner gaining rating points from the loser, depending on the rating difference between them.","models_leaderboard_hours":"Hours","models_leaderboard_join_time":"Join time","models_leaderboard_last_updated":"Last updated","models_leaderboard_leaderboard_waiting_description":"To ensure the accuracy and confidence of the data, we are still working on collecting voting data","models_leaderboard_leaderboard_waiting_title":"Time until leaderboard reveal","models_leaderboard_model":"Model","models_leaderboard_munutes":"Minutes","models_leaderboard_rank":"Ranking","models_leaderboard_seconds":"Seconds","models_leaderboard_title":"Leaderboard - Model Square - Coze","models_leaderboard_total_models":"Total Models","models_leaderboard_total_votes":"Total Votes","models_leaderboard_vote_now":"Vote Now","models_leaderboard_votes":"Votes","models_param_class_1":"Generation diversity","modules_menu_guide":"\uD83D\uDE80 On demand selection of functional modules for display, making agent development more efficient!","modules_menu_guide_gotit":"Got it","modules_menu_guide_warning":"Unable to hide modules with added content","monetization":"User message billing","monetization_des":"When enabled, the user covers the credit costs; when disabled, the bot creator covers the credit costs.","monetization_off":"User message billing (off)","monetization_off_des":"User message billing is disabled. The bot creator covers the credit costs. When enabled, the user covers the credit costs.","monetization_on":"User message billing (on)","monetization_on_des":"User message billing is enabled. The user covers the credit costs, and a bill will be sent when the user\'s balance is depleted. When disabled, the bot creator covers the credit costs. ","monetization_on_viewbill":"Bill preview","monetization_publish_fail":"User message billing failed","monetization_publish_off":"Off","monetization_publish_on":"On","monetization_publish_suc":"User message billing succeed","monetization_status":"User message billing status","monetization_support":"Support platforms","monetization_support_tips":"Supported platforms","more":"more","move_desc1":"Note: Agents using the professional version of the Ark model need to manually switch the model after migration, otherwise it cannot be used normally","move_failed":"Migration failed","move_failed_btn_cancel":"Cancel migration","move_failed_btn_force":"Force migrate agent","move_failed_cancel_confirm_content":"Even if the migration is canceled, the resources that have already been migrated will remain in the new team space, but the agent and any resources that failed to migrate will stay in the original team space.","move_failed_cancel_confirm_title":"Are you sure you want to cancel the agent migration?","move_failed_desc":"The agent has not been migrated to the new space due to the migration failure of the following resources. Please click the button below to retry. If you click \\"Force migrate agent\\", the resources that failed to migrate will remain in the original space, but the agent will be migrated to the new space.","move_failed_force_confirm_content":"After direct migration, resources that fail to migrate will remain in the original space, while the agent will be moved to the new team space.","move_failed_force_confirm_title":"Are you sure you want to directly migrate the agent to the new team space?","move_failed_toast":"Agent migration failed. Please click on the agent card for more details.","move_not_allowed_contain_bot_nodes":"Sorry, the current agent includes sub-agents and cannot be migrated. To migrate the agent, please remove the sub-agents from it, or migrate the sub-agents to the same target team space first.","move_workspace_pop_up_node_name1_choose_workspace":"Choose workspace","mp_open_type_setter_card_setting":"style setting","mp_open_type_setter_card_title":"Link display style","multiagent_bot_update_auto_time":"{time} updated","multiagent_bot_update_setting_auto_subtitle":"After the Agent referenced by a node publishes an update, the update takes effect on the current node and online in real time, without the need to republish the multi-agent agent.","multiagent_bot_update_setting_auto_title":"Auto update","multiagent_bot_update_setting_manual_subtitle":"After the Agent referenced by the node releases the update, it needs to click the update button for manual update. This update does not take effect for online users until the multi-agent agent is released.","multiagent_bot_update_setting_manual_title":"Manual update","multiagent_bot_update_setting_subtitle":"The change will take effect immediately in the current draft and will need to be republished for the online version to take effect.","multiagent_bot_update_setting_title":"Update setting","multiagent_bot_update_tooltip_title":"Click to upgrade to the latest version","multiagent_detail_agent_node_copy_id_button":"Copy agent ID","multiagent_detail_agent_node_copy_id_toast":"Copied","multiagent_edit_node_agent_name_default":"New agent","multiagent_host_jump_condition_setting_backtrack_hover":"Your selection to send the new round of conversation to the start node renders this setting invalid in this mode.","multiagent_host_node_chatting_tooltip":"You have chosen to send the new round of conversation to the start node. After clicking, this node will be temporarily set as the starting node, and the next round of conversation will temporarily run from this node.\\nPlease note that the published agent still defaults to converse with the start node.","multiagent_host_node_sign_tooltip":"The next round of conversation will temporarily run from this node.\\nPlease note that the published agent still defaults to converse with the start node.","multiagent_node_line_limit_toast":"A maximum of 30 nodes can be connected","multiagent_node_line_limit_tost":"A maximum of 30 nodes can be connected","multiagent_node_scenarios_context_default":"Used for a \\"FUNCTION\\". It helps you solve problems of a \\"SCENARIO\\".","multiagent_node_scenarios_place_holder":"Summarize the function and application scenarios of this node for the preceding nodes to understand under what circumstances they should switch to this node.","multiagent_node_scenarios_title":"Scenarios","multiagent_node_scenarios_tooltip":"Summarize the function and application scenarios of this node for the preceding nodes to understand under what circumstances they should switch to this node.\\nFor example:\\n- Helping users solve fitness-related questions.\\n- Searching scenic spots and making travel plans.\\n- Generating pictures according to user requirements.","multiagent_node_scenarios_tooltip_1":"Introduce the function and supported scenarios of this node to help users in preceding nodes better understand switch scenarios.","multiagent_node_scenarios_tooltip_2":"For example:","multiagent_node_scenarios_tooltip_3":"- Helps you solve fitness-related questions.","multiagent_node_scenarios_tooltip_4":"- Searches for scenic spots and makes travel plans.","multiagent_node_scenarios_tooltip_5":"- Generates images according to your requirements.","multiagent_node_switch_tips_context":"According to the applicable scenarios of the connected nodes, switch the user\'s conversation to the connected node at the appropriate time.","multiagent_node_switch_tips_title":"Switch node","multiagent_previous_version_display_banner":"Because the previous version canvas has stopped maintenance and the previous version data is being loaded using the new version canvas, jump conditions in the previous version canvas will not be displayed.","multiagent_previous_version_publish_forbidden_hover":"This mode needs to be upgraded to the new version before it can be published","multiagent_previous_version_submit_forbidden_hover":"This mode needs to be upgraded to the new version before it can be submitted","multiagent_revert_hint_button_disappear":"Don\'t show again","multiagent_revert_hint_button_revert":"View previous version","multiagent_revert_hint_context":"Upgraded to the new version, it is recommended to thoroughly debug to ensure functionality is normal. You can view the previous version in the \\" ? \\" entrance at the bottom right corner of the canvas.","multiagent_revert_popup_context":"After reverting to the previous version, the agent will not be able to edit and publish.","multiagent_revert_popup_title":"Are you sure you want to view the previous version?","multiagent_root_bot_deleted_dialog":"The agent connected to \\"Start\\" was deleted, please reconnect to a valid node.","multiagent_shortcut_modal_specify_node":"Specify a node to answer","multiagent_shortcut_modal_specify_node_option_do_not_specify":"Do not specify","multiagent_start_settings_flow_context":"The user\'s new message will continue to be sent to the node that responded to the user last time. The next message after manually clearing the context will be sent to the start node.","multiagent_start_settings_flow_title":"The node that responded to the user last time","multiagent_start_settings_host_context":"All messages from the user will be sent to the start node. If you click the conversation button in the top right corner of the node, you can temporarily start from this node during debugging. The position of the start node will be restored after manually clearing the context.","multiagent_start_settings_host_title":"Start node","multiagent_start_settings_title":"Which node should the new round of conversation be sent to?","multiagent_switch_independent_dialog_rounds":"Dialog rounds considered for the judgment","multiagent_switch_independent_dialog_rounds_tooltip":"If the value exceeds the maximum number of dialog rounds set globally, the global setting prevails.","multiagent_switch_independent_llm_model":"Large language model","multiagent_switch_independent_llm_model_description":"The large language model achieves better results based on the user-customized switch prompts, but is slower and requires additional charges.","multiagent_switch_independent_llm_model_example":"Examples:\\n- When the user expresses an intention of hunger or dining, switch to the \\"Nearby Restaurant Recommendations\\" node.\\n- When the agent finds out that the weather is clear today, switch to the \\"Outdoor Camping Planning\\" node.","multiagent_switch_independent_llm_model_tips":"The name of nodes that can be switched to may be referenced in the prompt","multiagent_switch_independent_select_model":"Select the independent model","multiagent_switch_independent_special_model":"Model trained for switch nodes","multiagent_switch_independent_special_model_description":"This model is faster, can adapt to most general scenarios, and does not require additional charges.","multiagent_switch_independent_timing":"Timing of judgment","multiagent_switch_independent_timing_model":"After model answer","multiagent_switch_independent_timing_user":"After user input","multiagent_switch_independent_timing_user_model":"After user input & After model answer","multiagent_upgrade_hint_button":"Upgrade to the new version","multiagent_upgrade_hint_button_second":"Back to new version","multiagent_upgrade_hint_context":"The multi-agent mode has released a new version: it supports connecting to more relay nodes and supports starting sessions from a fixed node every time. The current version no longer supports editing. Do you want to upgrade to the new version?","multiagent_upgrade_hint_context_second":"This canvas is an previous version. The previous version only supports viewing data. Please return to the new version for editing","multiagent_upgrade_popup_after":"After the upgrade","multiagent_upgrade_popup_after_1":"This jump condition will be set as the applicable scenarios for this node","multiagent_upgrade_popup_after_2":"These jump conditions will be merged into the applicable scenarios for this node. This situation may affect the jump function to some extent. Please make sure to thoroughly debug","multiagent_upgrade_popup_after_3":"This jump condition will disappear","multiagent_upgrade_popup_after_4":"Automatically add default applicable scenarios for this node","multiagent_upgrade_popup_after_5":"Remain unchanged","multiagent_upgrade_popup_before":"Before the upgrade","multiagent_upgrade_popup_before_1":"Only one jump condition is connected or multiple identical jump conditions are connected before the node","multiagent_upgrade_popup_before_2":"Multiple different jump conditions are connected before the node","multiagent_upgrade_popup_before_3":"The jump condition is not connected to any node","multiagent_upgrade_popup_before_4":"No jump conditions are connected before the node","multiagent_upgrade_popup_before_5":"Global jump condition","multiagent_upgrade_popup_context":"In the new version, we have replaced the jump conditions with applicable scenarios and added an option to always start the conversation from a fixed node.\\n  This version update will not affect your already published agents until you republish. We have ceased the functional iteration of the current version, so please try to use the new version to access the latest features. Please do not worry, as you can still revert to the previous version for a period of time after the upgrade.","multiagent_upgrade_popup_title":"Upgrade Notice","multimodal_upload_file":"Upload failure","my_favorite_bots":"My favorite agents","my_favorites":"My favorites"