1\\",\\n        \\"location_country\\": \\"ph\\",\\n        \\"db_read_mode\\": \\"1\\",\\n        \\"db_write_mode\\": \\"1\\"\\n      },\\n      \\"bot_engine_agent\\": {\\n        \\"agent_all\\": {\\n          \\"chat\\": \\"{\\\\\\"model_id\\\\\\":1708935709}\\"\\n        },\\n        \\"agent_7350933295489892370\\": {\\n          \\"chat\\": \\"{\\\\\\"search_module_config\\\\\\":{\\\\\\"search_module_dsl\\\\\\":\\\\\\"{\\\\\\\\\\\\\\"nodes\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"query_split\\\\\\\\\\\\\\",\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"LLMQuerySplit\\\\\\\\\\\\\\"},{\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"global_search\\\\\\\\\\\\\\",\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"GlobalSearch\\\\\\\\\\\\\\",\\\\\\\\\\\\\\"config\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\"top_k\\\\\\\\\\\\\\":5,\\\\\\\\\\\\\\"need_full_text\\\\\\\\\\\\\\":true}},{\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"prompt_builder\\\\\\\\\\\\\\",\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"SearchPromptBuilder\\\\\\\\\\\\\\"}],\\\\\\\\\\\\\\"graph\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"query_split -> global_search -> prompt_builder\\\\\\\\\\\\\\"}\\\\\\"}}\\"\\n        },\\n        \\"agent_7369482712421335058\\": {\\n          \\"chat\\": \\"{\\\\\\"retrievers\\\\\\":{\\\\\\"service\\\\\\":{\\\\\\"recall_links\\\\\\":{\\\\\\"max_token\\\\\\":128000}}}}\\"\\n        }\\n      },\\n      \\"bot_engine\\": {\\n        \\"bot_mapping_config\\": {\\n          \\"target_bot_id\\": \\"7350874563795845138\\"\\n        }\\n      }\\n    },\\n    \\"ext\\": {\\n      \\"answer_with_suggest\\": \\"1\\",\\n      \\"media_search_type\\": \\"1\\",\\n      \\"wiki\\": \\"1\\"\\n    },\\n    \\"update_version_code\\": \\"6050040\\"\\n  }\\n}","runtime_parameter_tips_coze_bot":"不需要特殊指定运行参数时无需关注；\\n\\n支持的运行时参数示例如下：\\n{\\n  \\"env\\": \\"test\\", //泳道环境\\n  \\"model_type\\": \\"3\\", //即model_id，需要指定特定的模型时，填写该参数（同时对多agent模式的bot中的所有agent生效）\\n  \\"user_id\\": \\"1234567\\" // coze平台上的userID\\n  \\"user_nickname\\": \\"\\", // 用户昵称，豆包/cici个性化需求使用\\n  \\"connector_uid\\": \\"\\", // 渠道用户ID\\n  \\"tools_auth_info\\": {}, // 插件授权信息\\n  \\"ext\\": {} // 扩展字段\\n}","runtime_parameter_tips_custom":"不需要特殊指定运行参数时无需关注；\\n\\n支持的运行时参数示例如下：\\n{\\n  \\"env\\": \\"test\\" // 泳道环境\\n}","runtime_parameter_tips_fornax_agent":"不需要特殊指定运行参数时无需关注；\\n\\n支持的运行时参数示例如下：\\n{\\n  \\"env\\": \\"test\\" // 泳道环境\\n}","runtime_parameter_tips_fornax_app":"不需要特殊指定运行参数时无需关注；\\n\\n支持的运行时参数示例如下：\\n{\\n  \\"env\\": \\"test\\", // 泳道环境\\n  \\"cluster\\": \\"default\\" //集群\\n}","save_overlimit_disable":"保存后，超过限额用户将立刻停用","scaling_activate":"开通","scaling_activate_failed":"扩容开通失败","scaling_activated":"扩容已开通","scaling_active":"生效中","scaling_active_status":"扩容生效中","scaling_api":"API","scaling_base_plus_extra":"基础值 {basic} + 扩容值 {extra}","scaling_billing_tip":"开通后1小时自动出账，不支持退款","scaling_cancel":"取消扩容","scaling_cancel_tip":"取消后，已生效的时间区间正常出账（按小时），未生效的时间区间不出账。{type}将下调为{num}，可能会对线上服务造成影响。","scaling_cancelled":"已取消","scaling_cancelled_status":"扩容已取消","scaling_concurrency":"并发扩容","scaling_confirm_activate":"开通{type}扩容？","scaling_current_limit":"当前限速","scaling_date_range":"开始日期-结束日期","scaling_effective_time":"生效时间","scaling_expand":"扩容","scaling_expand_type":"{type}扩容","scaling_expand_type_desc":"为指定{type}进行扩容，扩容后仅提升资源的限速，不减免请求资源本身的计费","scaling_expired":"已过期","scaling_expired_status":"扩容已过期","scaling_free_limited":"限时免费","scaling_input_value":"请输入需要扩容的数值","scaling_integer_only":"可扩容{num}的整数值，在当前限速上叠加生效","scaling_management":"扩容管理","scaling_max_tip":"最大值{max}，如需更多资源，请{link}","scaling_no":"否","scaling_no_permission":"暂无操作权限，如需要操作请联系超级管理员","scaling_pending":"待生效","scaling_pending_status":"扩容待生效","scaling_per_hour":"/小时","scaling_plugin":"插件","scaling_price":"价格","scaling_show_enabled_only":"只看已开通扩容项","scaling_submit_ticket":"提交工单","scaling_view_details":"查看详情","scaling_voice":"语音","scaling_yes":"是","scaling_yuan":"元","scene_background_tooltip":"场景运行时，这部分信息会被拼装在 Host 和所有其他成